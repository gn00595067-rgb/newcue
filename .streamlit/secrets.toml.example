# Streamlit 機密設定範本 —— 複製成 secrets.toml 後填入真實值
# 本機：放在 .streamlit/secrets.toml（已被 .gitignore 擋掉）
# Streamlit Cloud：在 App 的 Settings → Secrets 貼上同樣內容
RAGIC_API_KEY = "在此填入 Ragic API Key"
RAGIC_URL = "https://ap16.ragic.com/soundwow/cue/2?PAGEID=jQV"
SUPERVISOR_PASSWORD = "在此填入主管密碼"
AGENCY_PASSWORD = "在此填入代理商CUE密碼"
# Ragic 正式寫入開關（新增客戶／之後的存檔、訂檔）。未設或非 true＝乾跑，只預覽不寫入。
# 測試 app 先不要設；確認乾跑內容正確後再改成 "true"。
RAGIC_WRITE_ENABLED = "false"
# 送出訂檔時是否真的寫入「CUE號申請表」與「訂檔表」（正式表單）。未設或非 true＝送出按鈕停用。
RAGIC_BOOKING_ENABLED = "false"
# 營運主管／管理員的 Ragic 信箱（逗號分隔）：可看所有業務的 CUE、抽查退回、營運加贈；主管密碼登入者亦同
RAGIC_REVIEWERS = ""
# 業務代碼撞號時覆寫（信箱=代碼，逗號分隔），例："amy@soundwow.com=AM, alison@soundwow.com=AL"
RAGIC_SALES_CODES = ""
# 開發者登入（只設在測試 app；正式 app 不要設＝入口不出現）：沒有公司 Ragic 帳號的開發者用此身分實測
# 身分信箱可放進 RAGIC_REVIEWERS 取得主管功能；存檔紀錄會掛在此名字下，試完請刪測試資料
DEV_LOGIN_PASSWORD = ""
DEV_LOGIN_NAME = "Jonathan"
DEV_LOGIN_EMAIL = "jonathan@dev"
# 同事登入密碼表（Ragic 會擋 Streamlit Cloud 的帳密登入）：帳號＝公司信箱或員工工號，預設密碼 123456，
# 第一次登入必須改密碼；密碼雜湊存在 newcue 設定檔 Google Sheet 的「登入密碼」分頁（自動建立），
# 刪掉某人那列＝重設回 123456。設定檔 Sheet 要共用給下方服務帳號的 client_email（編輯者）。
# 未設 [gcp_service_account] 時改用 Ragic 帳密登入（僅本機可用）。要改存別份 Sheet 才設：
# APP_PASSWORD_SHEET_URL = "https://docs.google.com/spreadsheets/d/xxxx/edit"

[gcp_service_account]
# 貼上 Google 服務帳號 JSON 的內容（可沿用 cueupload 的同一個服務帳號）
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
